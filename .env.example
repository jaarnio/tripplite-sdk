# Tripplite PDU Configuration
# Copy this file to .env and update with your PDU details

# PDU Host (IP address or hostname)
TRIPPLITE_PDU_HOST=192.168.31.164

# PDU Port (default is 443 for HTTPS)
TRIPPLITE_PDU_PORT=443

# Authentication credentials
TRIPPLITE_PDU_USERNAME=power-dev
TRIPPLITE_PDU_PASSWORD=password

# Device ID (default is 1)
TRIPPLITE_PDU_DEVICE_ID=1

# WebSocket Server Configuration
# WebSocket server port
WS_PORT=8080

# Maximum number of WebSocket clients
WS_MAX_CLIENTS=16

# PDU polling interval in milliseconds
PDU_POLL_INTERVAL=5000

# Maximum retry attempts for PDU communication
PDU_MAX_RETRIES=3

# Delay between retries in milliseconds
PDU_RETRY_DELAY=1000

# WebSocket heartbeat interval in milliseconds
WS_HEARTBEAT_INTERVAL=30000

# Client timeout in milliseconds
WS_CLIENT_TIMEOUT=60000

# Logging configuration
LOG_LEVEL=info
ENABLE_DEBUG=false 