{
  "name": "@jaarnio/tripplite-pdu-sdk",
  "version": "1.2.0",
  "description": "SDK for interacting with Tripplite PDU devices",
  "main": "dist/index.js",
  "types": "types/index.d.ts",
  "files": [
    "dist",
    "types",
    "README.md",
    ".env.example"
  ],
  "scripts": {
    "test": "jest",
    "prebuild": "rimraf dist",
    "build": "babel src -d dist --copy-files",
    "prepare": "npm run build",
    "docs": "jsdoc -c jsdoc.json",
    "lint": "eslint src",
    "ws:start": "node websocket-server/start-server.js",
    "ws:test": "node websocket-server/tests/client-test.js",
    "ws:dev": "ENABLE_DEBUG=true LOG_LEVEL=debug node websocket-server/start-server.js"
  },
  "keywords": [
    "tripplite",
    "pdu",
    "power",
    "management",
    "sdk"
  ],
  "author": "jaarnio",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.6.7",
    "dotenv": "^16.0.0",
    "ws": "^8.14.0"
  },
  "devDependencies": {
    "@babel/cli": "^7.23.9",
    "@babel/core": "^7.24.0",
    "@babel/preset-env": "^7.24.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "jsdoc": "^4.0.2",
    "rimraf": "^5.0.10"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jaarnio/tripplite-pdu-sdk.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "bugs": {
    "url": "https://github.com/jaarnio/tripplite-pdu-sdk/issues"
  },
  "homepage": "https://github.com/jaarnio/tripplite-pdu-sdk#readme"
}
